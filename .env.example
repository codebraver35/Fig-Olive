# ==============================================
# Fig & Olive · Environment Variables Configuration
# Copy this file to .env and fill in your actual credentials.
# ==============================================

# Server Configuration
PORT=8000
NODE_ENV=production

# MySQL Database Configuration (Standard Host Credentials)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=restaurant_db
DB_SSL=false # Set to true for cloud MySQL providers requiring SSL (e.g. Aiven)

# Optional: Cloud Database URL (Used by Railway / Render if preferred over individual DB_* variables)
# DATABASE_URL=mysql://user:password@host:port/database

# JWT Authentication Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_for_production
JWT_EXPIRES_IN=1d

# ImageKit Cloud Storage Credentials (https://imagekit.io)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

